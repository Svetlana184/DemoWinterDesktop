<Window x:Class="MiracleShoes1.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiracleShoes1.View"
        mc:Ignorable="d"
        Title="Вход в систему — Чудо Обувь" Height="320" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource MainBackground}">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock Text="Выберите логин:" FontSize="14" Margin="0,0,0,5"/>
        <ComboBox x:Name="LoginComboBox" Width="260" Height="30"
                  ItemsSource="{Binding AvailableLogins}"
                  SelectedItem="{Binding SelectedLogin, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="Войти" Width="140" Height="35" Margin="0,20,0,0"
                Background="{StaticResource AccentColor}" Foreground="White" FontWeight="Bold"
                Command="{Binding LoginCommand}"/>
    </StackPanel>
</Window>
